# Supabase (NEXT_PUBLIC_* dəyərləri brauzerdə görünür, sirr deyil)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Auth e-poçt və OAuth yönləndirmələrində istifadə olunan əsas sayt URL-i.
# Supabase > Authentication > URL Configuration ilə eyni olmalıdır.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
